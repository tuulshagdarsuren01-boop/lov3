<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Happy Monthsary, Love!</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Gaegu:wght@400;700&family=Gochi+Hand&family=Old+Standard+TT:ital@0;1&family=Dancing+Script:wght@700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#4b0f0f;
  --bg-deep:#380909;
  --paper:#f5dfab;
  --cream:#fbe6c2;
  --gold:#e8c77a;
  --rose:#b3122a;
  --ink:#4b0f0f;
  --script:'Pinyon Script',cursive;
  --hand:'Gaegu',cursive;
  --sticker:'Gochi Hand',cursive;
  --serif:'Old Standard TT',Georgia,serif;
}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{
  background:radial-gradient(ellipse at 50% 40%,#5a1212 0%,var(--bg) 55%,var(--bg-deep) 100%) fixed;
  color:var(--cream);font-family:var(--serif);overflow:hidden;
}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
:focus-visible{outline:2px solid var(--gold);outline-offset:4px;border-radius:6px}

.view{position:fixed;inset:0;overflow-y:auto;overflow-x:hidden;opacity:0;pointer-events:none;visibility:hidden;
  transition:opacity .5s ease,visibility 0s .5s;-webkit-overflow-scrolling:touch}
.view.active{opacity:1;pointer-events:auto;visibility:visible;transition:opacity .5s ease}

/* ---------- cover ---------- */
#cover{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px 16px 40px}
#cover h1{font:400 clamp(2.6rem,7vw,5.2rem)/1.1 var(--script);color:var(--cream);margin-bottom:3vh}
.envelope-btn{display:block;width:min(330px,70vw);transform:rotate(-4deg);transition:transform .35s ease;filter:drop-shadow(6px 10px 10px rgba(0,0,0,.45))}
.envelope-btn:hover{transform:rotate(-2deg) scale(1.04)}
.envelope-btn svg{width:100%;overflow:visible;display:block}
#flap{transform-box:view-box;transform-origin:160px 40px;transition:transform .8s cubic-bezier(.5,0,.2,1)}
#seal{transition:opacity .3s ease .15s}
.opening #flap{transform:scaleY(-1)}
.opening #seal{opacity:0}
.opening .envelope-btn{transform:rotate(0) scale(1.08)}
.tap{font:400 clamp(1.4rem,3vw,1.9rem)/1 var(--hand);color:#f3c9bd;margin-top:6vh;letter-spacing:.02em}

/* ---------- menu ---------- */
#menu{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 16px}
#menu h2{font:400 clamp(2.4rem,6vw,3.8rem)/1 var(--hand);color:#fff;letter-spacing:.06em;margin-bottom:clamp(24px,8vh,80px)}
.choices{display:flex;gap:clamp(24px,9vw,140px);flex-wrap:wrap;justify-content:center;align-items:flex-end}
.choice{display:flex;flex-direction:column;align-items:center;gap:18px;font:400 clamp(1.3rem,2.6vw,1.9rem)/1 var(--serif);color:#fff;transition:transform .3s ease}
.choice .sprite{image-rendering:pixelated;width:auto;filter:drop-shadow(3px 6px 0 rgba(0,0,0,.35));transition:transform .3s ease}
.sprite-scroll{height:clamp(110px,17vw,160px)}
.sprite-bouquet{height:clamp(150px,24vw,220px)}
.sprite-vinyl{height:clamp(100px,16vw,150px)}
.choice:hover .sprite{transform:translateY(-8px)}
#menu.active .choice{animation:rise .6s both}
#menu.active .choice:nth-child(2){animation-delay:.12s}
#menu.active .choice:nth-child(3){animation-delay:.24s}
@keyframes rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}

.back{display:block;margin:28px auto 36px;padding:6px 22px;background:var(--cream);color:var(--ink);border-radius:999px;font:700 .95rem/1.4 var(--serif);letter-spacing:.14em;border:2px solid #e2b78a;box-shadow:0 3px 8px rgba(0,0,0,.35);transition:transform .2s}
.back:hover{transform:translateY(-2px)}

/* ---------- photos ---------- */
.photo{position:relative;background:#fff7ea;padding:5px;box-shadow:0 3px 8px rgba(0,0,0,.35);cursor:pointer;display:block;width:100%}
.photo .img{aspect-ratio:4/5;background:linear-gradient(145deg,#f3b8b0,#d98479) center/cover no-repeat;display:grid;place-items:center;color:#fff7ea}
.photo .img svg{width:34%;opacity:.85}
.photo input{display:none}

/* ---------- letter ---------- */
#letter{padding:6vh 0 0}
.paper{position:relative;width:min(920px,calc(100% - 56px));margin:0 auto;background:
   radial-gradient(circle at 20% 30%,rgba(255,255,255,.35),transparent 55%),
   radial-gradient(circle at 80% 80%,rgba(214,170,90,.25),transparent 50%),var(--paper);
  color:#3a1a12;padding:clamp(28px,6vw,56px) clamp(22px,6vw,70px) clamp(60px,8vw,90px);
  min-height:min(520px,70vh);box-shadow:0 10px 30px rgba(0,0,0,.4)}
.paper::before{content:"";position:absolute;left:-14px;top:0;bottom:0;width:28px;
  background:radial-gradient(circle at 14px 20px,var(--bg) 13px,transparent 13.6px) 0 0/28px 40px repeat-y}
.paper::after{content:"";position:absolute;left:0;right:0;bottom:-13px;height:26px;
  background:radial-gradient(circle at 20px 13px,var(--bg) 13px,transparent 13.6px) 0 0/40px 26px repeat-x}
.paper p{font:400 clamp(.95rem,1.6vw,1.12rem)/1.75 var(--serif);margin-bottom:1.1em;max-width:62ch}
.paper .sign{font:400 1.9rem/1 var(--script);margin-top:1.4em}
.tulips{position:absolute;left:-46px;bottom:-12px;width:clamp(70px,11vw,130px)}

/* ---------- flowers ---------- */
#flower{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28px 16px 12px}
.bouquet-scene{display:grid;grid-template-columns:1fr auto 1fr;gap:clamp(12px,3vw,40px);align-items:center;width:min(1100px,100%)}
.col{display:flex;flex-direction:column;gap:clamp(18px,5vh,44px)}
.col.l{align-items:flex-end}.col.r{align-items:flex-start}
.bubble{font:400 clamp(.75rem,1.2vw,1rem)/1.25 var(--sticker);color:var(--rose);background:var(--cream);text-transform:uppercase;padding:7px 12px;border-radius:12px;max-width:240px;text-align:center;
  box-shadow:0 0 0 3px var(--cream),0 6px 10px rgba(0,0,0,.3)}
.col.l .bubble:nth-child(1){transform:translateX(-30px) rotate(-1deg)}
.col.l .bubble:nth-child(2){transform:translateX(18px) rotate(1deg)}
.col.l .bubble:nth-child(3){transform:translateX(-14px) rotate(-1.5deg)}
.col.r .bubble:nth-child(1){transform:translateX(26px) rotate(1deg)}
.col.r .bubble:nth-child(2){transform:translateX(-10px) rotate(-1deg)}
.col.r .bubble:nth-child(3){transform:translateX(22px) rotate(1.5deg)}
#flower.active .bubble{animation:pop .5s both}
#flower.active .col .bubble:nth-child(1){animation-delay:.2s}
#flower.active .col .bubble:nth-child(2){animation-delay:.4s}
#flower.active .col .bubble:nth-child(3){animation-delay:.6s}
@keyframes pop{from{opacity:0;scale:.7}to{opacity:1;scale:1}}
.bq-card{width:clamp(230px,33vw,420px);border:4px solid transparent;border-radius:22px;padding:20px 10px 14px;text-align:center;box-shadow:0 10px 24px rgba(0,0,0,.4);
  background:linear-gradient(#a8161f,#8d1119) padding-box,linear-gradient(135deg,#f7e3a0 0%,#d4a93c 30%,#fff0b8 50%,#c9982e 70%,#f1d584 100%) border-box}
.bq-card .roses{width:100%;display:block;image-rendering:pixelated;filter:drop-shadow(0 4px 0 rgba(0,0,0,.25))}
.bq-card span{display:block;font:400 clamp(1.6rem,3.6vw,3rem)/1 var(--script);margin-top:12px;background:linear-gradient(#fff0b8,#d4a93c 60%,#b8861f);-webkit-background-clip:text;background-clip:text;color:transparent}
@media (max-width:760px){
  #flower{justify-content:center;padding-top:24px}
  .bouquet-scene{gap:6px;grid-template-columns:1fr auto 1fr}
  .bq-card{width:46vw;padding:12px 6px 10px;border-width:3px}
  .col{gap:14px}
  .col.l,.col.r{align-items:stretch}
  .bubble{font-size:clamp(.6rem,2.7vw,.72rem);padding:5px 6px;border-radius:10px;max-width:none;box-shadow:0 0 0 2px var(--cream),0 4px 8px rgba(0,0,0,.3)}
  .col.l .bubble:nth-child(n){transform:rotate(-1deg)}
  .col.r .bubble:nth-child(n){transform:rotate(1deg)}
}

/* ---------- song ---------- */
#song{padding:5vh 16px 0}
#song h2{font:400 clamp(2.2rem,5.5vw,3.6rem)/1.1 var(--script);color:var(--gold);text-align:center;margin-bottom:24px}
.song-wrap{position:relative;width:min(760px,100%);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr);gap:20px}
.player{position:relative;min-height:clamp(250px,34vw,360px)}
.vinyl{position:absolute;left:0;top:0;width:clamp(230px,34vw,360px);aspect-ratio:1;border-radius:50%;
  background:repeating-radial-gradient(circle,#141010 0 2px,#2c2222 3px 4px),#141010;
  box-shadow:0 10px 24px rgba(0,0,0,.5);animation:spin 9s linear infinite;animation-play-state:paused}
.song-wrap.playing .vinyl{animation-play-state:running}
.vinyl::before{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 30deg,transparent 0 20%,rgba(255,255,255,.14) 25%,transparent 32% 70%,rgba(255,255,255,.1) 75%,transparent 82%)}
.vinyl i{position:absolute;inset:32%;border-radius:50%;background:radial-gradient(circle,#1a1010 0 3%,#c9453a 4% 100%);border:4px solid #f0d3c8}
.video{position:absolute;left:clamp(110px,24vw,250px);top:clamp(14px,3vw,30px);width:calc(100% - clamp(110px,24vw,250px));max-width:470px;aspect-ratio:16/9;background:#111;border-radius:4px;box-shadow:0 10px 24px rgba(0,0,0,.55);overflow:hidden;display:grid;place-items:center;text-align:center;font:.9rem/1.4 var(--serif);color:#ddd;padding:12px}
.video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.video a{color:var(--gold)}
.note{background:#e3b98d;color:var(--ink);padding:16px 18px;border-radius:6px 6px 6px 0;font:400 clamp(.9rem,1.5vw,1.05rem)/1.6 var(--serif);text-align:justify;box-shadow:0 6px 14px rgba(0,0,0,.35);margin-top:4px}
@keyframes spin{to{transform:rotate(360deg)}}

@media (prefers-reduced-motion:reduce){
  ,::before,*::after{animation:none !important;transition-duration:.01s !important}
}
</style>
</head>
<body>

<!-- COVER -->
<section class="view active" id="cover" aria-label="Cover">
  <h1 id="title"></h1>
  <button class="envelope-btn" id="openBtn" aria-label="Open the envelope">
    <svg viewBox="0 0 320 240" role="img" aria-hidden="true">
      <defs>
        <linearGradient id="pp" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f2e3bd"/><stop offset="1" stop-color="#dcc592"/></linearGradient>
        <radialGradient id="wax" cx=".4" cy=".35" r=".7"><stop offset="0" stop-color="#d8473f"/><stop offset="1" stop-color="#9c1f1f"/></radialGradient>
      </defs>
      <rect x="10" y="40" width="300" height="180" rx="4" fill="url(#pp)" stroke="#c9ad74" stroke-width="1.5"/>
      <polygon points="10,40 160,142 10,220" fill="#ead8a8" stroke="#c9ad74"/>
      <polygon points="310,40 160,142 310,220" fill="#ead8a8" stroke="#c9ad74"/>
      <polygon points="10,220 160,118 310,220" fill="#efe0b6" stroke="#c9ad74"/>
      <g id="flap">
        <polygon points="10,40 160,160 310,40" fill="url(#pp)" stroke="#c9ad74" stroke-width="1.5"/>
        <g id="seal">
          <g stroke="#9a8a4a" stroke-width="2" fill="none" stroke-linecap="round"><path d="M170 118 C176 98 182 84 190 66"/><path d="M178 96 L166 88"/><path d="M184 80 L196 76"/></g>
          <g fill="#d2a43f"><circle cx="190" cy="64" r="4"/><circle cx="198" cy="72" r="3.5"/><circle cx="182" cy="62" r="3.5"/><circle cx="165" cy="86" r="3"/><circle cx="196" cy="58" r="3"/></g>
          <circle cx="160" cy="132" r="25" fill="url(#wax)"/>
          <circle cx="160" cy="132" r="19" fill="none" stroke="#7c1414" stroke-width="2"/>
          <path d="M160 143 C148 134 147 124 154 122 C157 121 159 123 160 125 C161 123 163 121 166 122 C173 124 172 134 160 143Z" fill="none" stroke="#7c1414" stroke-width="2.2" stroke-linejoin="round"/>
        </g>
      </g>
    </svg>
  </button>
  <p class="tap" id="hint"></p>
</section>

<!-- MENU -->
<section class="view" id="menu" aria-label="Menu">
  <h2>For you</h2>
  <div class="choices">
    <button class="choice" data-go="letter">
      <img class="sprite sprite-scroll" src="data:image/png;base64," alt="" aria-hidden="true">
      Letter
    </button>
    <button class="choice" data-go="flower">
      <img class="sprite sprite-bouquet" src="data:image/png;base64," alt="" aria-hidden="true">
      Flower
    </button>
    <button class="choice" data-go="song">
      <img class="sprite sprite-vinyl" src="data:image/png;base64," alt="" aria-hidden="true">
      A song for you
    </button>
  </div>
</section>

<!-- LETTER -->
<section class="view" id="letter" aria-label="Letter">
  <article class="paper">
    <div id="letterText"></div>
    <svg class="tulips" viewBox="0 0 120 150" aria-hidden="true">
      <g stroke="#2f5a30" stroke-width="4" fill="none" stroke-linecap="round"><path d="M40 70 C42 100 46 120 50 148"/><path d="M62 66 C62 100 62 124 60 148"/><path d="M84 72 C80 100 74 124 66 148"/></g>
      <path d="M50 140 C20 120 10 90 18 70 C30 96 44 112 56 128Z" fill="#35683a"/>
      <g stroke="#6e0f17" stroke-width="2"><path d="M26 66 C22 40 32 22 40 16 C48 24 56 42 54 66 C46 74 34 74 26 66Z" fill="#c4262e"/><path d="M50 64 C46 36 58 16 66 10 C76 18 84 38 80 64 C72 72 58 72 50 64Z" fill="#d93a3a"/><path d="M72 70 C70 46 80 28 90 24 C98 34 102 52 96 70 C90 78 80 78 72 70Z" fill="#b01f2c"/></g>
    </svg>
  </article>
  <button class="back" data-go="menu">BACK</button>
</section>

<!-- FLOWERS -->
<section class="view" id="flower" aria-label="Flowers">
  <div class="bouquet-scene">
    <div class="col l" id="bubblesL"></div>
    <div class="bq-card">
      <img class="roses" src="data:image/png;base64," alt="" aria-hidden="true">
      <span id="bqLabel"></span>
    </div>
    <div class="col r" id="bubblesR"></div>
  </div>
  <button class="back" data-go="menu">BACK</button>
</section>

<!-- SONG -->
<section class="view" id="song" aria-label="Song">
  <h2 id="songTitle"></h2>
  <div class="song-wrap" id="songWrap">
    <div class="player">
      <div class="vinyl" aria-hidden="true"><i></i></div>
      <div class="video" id="video"></div>
    </div>
    <p class="note" id="songNote"></p>
  </div>
  <button class="back" data-go="menu">BACK</button>
</section>

<script>
/* =========================================================
   EDIT THIS PART — your own words, song and photos
   ========================================================= */
const CONFIG = {
  title: "ХӨӨРХӨН НАМУУН-ЭРДЭНЭ-Д  ЗОРИУЛСАН ЗАХИДАЛ",
  hint: "Tap to open!",

  letter: [
   "Миний хамгийн хайртай, хамгийн мундаг охинд энэ өдрийн мэнд. Эгэл жирийн өдрүүдийг минь онцгой болгож, амьдралын минь амар амгалан, хамгийн үзэсгэлэнтэй хэсэг нь болсонд чамдаа үргэлж баярладаг. Чамайг ямар их хичээж, өөрийнхөө төлөө, бидний ирээдүйн төлөө хэрхэн зүтгэж байгааг би үргэлж харж, зүрх сэтгэлээрээ бахархдаг шүү. Заримдаа ядарч, шантармаар хэцүү өдрүүд гардаг ч чиний дотор маш том хүч чадал байгаа гэдгийг хэзээ ч мартаж болохгүй. Амьдрал бидэнд юу ч тулгасан бай, би бид хоёрын харилцааг хэзээ ч орхихгүй бөгөөд инээд хөөр, нулимс дундуур, сайн ч, муу ч өдрүүдэд би үргэлж чинийхээ дэргэд зогсоно гэж амлаж байна. Чи бол миний хамтдаа хөгжиж, хамтдаа мөрөөдөж, мандах наран, жаргах нарыг хамтдаа угтахыг хүсдэг цорын ганц хүн юм шүү. Чи өөрийнхөө бодож байгаагаас ч илүү хүчирхэг, мундаг хүн шүү өөрийнхөө мөрөөдөлд итгээд үргэлж урагшаа тэмүүлээрэй. Надад байгаа энэ зүрх сэтгэл, энэ амлалт, бас энэ үүрд мөнх бүгд зөвхөн чинийх би алхам бүрт чинь тусалж, чиний амжилтыг хамтдаа тэмдэглэхэд үргэлж бэлэн байх болно. Би чамдаа хязгааргүй хайртай, бас үргэлж чиний талд зогсоно"
  ],
  signature: "Always yours",

  flowerLabel: "Зөвхөн чамд зориулсан цэцэгс",
  bubbles: [
    "Odor maani hicneen hvnd baisn ch chi urgelj nmaig ineemseglvvldg.",
    "chamtai ongorvvlsn horom moch bvhen minii nandignadg dursamj bolon ulddg.",
    "chamaigaa geh hair amidarliig ilvv utga uchirtai, saihn bolgodog.",
    "chinii halamj,derged min baih ter l zvil nadad mash ih utga uchirtai.",
    "chamtai ongorvvlsn hamgiin jijighen mochvvd hvrtel nadad mash ih utga uchirtai.",
    "zowhon chinii baigaa baidal l bvh zviliig ilvv saihn bolgodog."
  ],

   song: {
    heading: "Танд зориулсан дуу",
    youtubeIds: ["SOJpE1KMUbo"],
    query: "Dave Raindance ft Tems",
    note: "Дэлхий дээрх бүх хүмүүсээс яг чи миний амьдралд орж ирсэнд би үнэхээр баяртай байна. Чи миний амьдралд орж ирээд, хэзээ ч алдахыг хүсдэггүй тийм л эрхэм хүн минь болсон. Хэрэв дахин сонгох боломж гарвал би дахиад л чамайг сонгох байсан."
  },





  // Put image links here (e.g. "photos/1.jpg"). Or just tap any empty photo to pick one from your device.
  photos: []
};
/* ========================================================= */

const $ = s => document.querySelector(s);
const heart = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-8-5.4-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 5.6-8 11-8 11z"/></svg>';
let slot = 0;

function photo(){
  const i = slot++;
  const src = CONFIG.photos.length ? CONFIG.photos[i % CONFIG.photos.length] : "";
  const label = document.createElement("label");
  label.className = "photo";
  label.title = "Tap to choose a photo";
  const img = document.createElement("div");
  img.className = "img";
  if (src) img.style.backgroundImage = url("${src}"); else img.innerHTML = heart;
  const inp = document.createElement("input");
  inp.type = "file"; inp.accept = "image/*";
  inp.onchange = () => {
    const f = inp.files[0]; if (!f) return;
    const r = new FileReader();
    r.onload = () => { img.style.backgroundImage = url("${r.result}"); img.innerHTML = ""; };
    r.readAsDataURL(f);
  };
  label.append(img, inp);
  return label;
}

/* fill content */
$("#title").textContent = CONFIG.title;
document.title = CONFIG.title;
$("#hint").textContent = CONFIG.hint;

$("#letterText").innerHTML = CONFIG.letter.map(t => <p>${t}</p>).join("") + <p class="sign">${CONFIG.signature}</p>;

$("#bqLabel").textContent = CONFIG.flowerLabel;
CONFIG.bubbles.forEach((t, i) => {
  const b = document.createElement("div");
  b.className = "bubble"; b.textContent = t;
  (i < 3 ? $("#bubblesL") : $("#bubblesR")).append(b);
});

$("#songTitle").textContent = CONFIG.song.heading;
$("#songNote").textContent = CONFIG.song.note;

/* YouTube player: tries each id until one can be embedded */
let yt = null;
const ids = CONFIG.song.youtubeIds || [];
const wrap = $("#songWrap");
const setPlaying = on => wrap.classList.toggle("playing", on);
const search = "https://www.youtube.com/results?search_query=" + encodeURIComponent(CONFIG.song.query || "");
function giveUp(){
  $("#video").innerHTML = This song can't play inside the page.<br><a href="${search}" target="_blank" rel="noopener">Open it on YouTube</a>;
}
function plainFrame(id){
  $("#video").innerHTML = <iframe src="https://www.youtube.com/embed/${id}?playsinline=1&rel=0" title="Song" referrerpolicy="strict-origin-when-cross-origin" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>;
}
if (!ids.length) giveUp();
else {
  window.onYouTubeIframeAPIReady = () => {
    let i = 0;
    const holder = document.createElement("div");
    $("#video").innerHTML = ""; $("#video").append(holder);
    yt = new YT.Player(holder, {
      videoId: ids[0], width: "100%", height: "100%",
      playerVars: { playsinline: 1, rel: 0 },
      events: {
        onStateChange: e => {
          if (e.data === YT.PlayerState.PLAYING) setPlaying(true);
          else if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.ENDED) setPlaying(false);
        },
        onError: () => { i++; if (i < ids.length) yt.cueVideoById(ids[i]); else giveUp(); }
      }
    });
  };
  const api = document.createElement("script");
  api.src = "https://www.youtube.com/iframe_api";
  api.onerror = () => plainFrame(ids[0]);
  document.head.append(api);
}

/* navigation */
const views = ["cover","menu","letter","flower","song"];
function show(name){
  if (!views.includes(name)) name = "cover";
  views.forEach(v => $("#" + v).classList.toggle("active", v === name));
  if (name !== "song" && yt && yt.pauseVideo) yt.pauseVideo();
  $("#" + name).scrollTop = 0;
}
function go(name){ location.hash = name; }
window.addEventListener("hashchange", () => show(location.hash.slice(1)));
document.querySelectorAll("[data-go]").forEach(b => b.addEventListener("click", () => go(b.dataset.go)));

$("#openBtn").addEventListener("click", () => {
  const c = $("#cover");
  if (c.classList.contains("opening")) return;
  c.classList.add("opening");
  setTimeout(() => { go("menu"); setTimeout(() => c.classList.remove("opening"), 600); }, 1000);
});

show(location.hash.slice(1));
</script>
